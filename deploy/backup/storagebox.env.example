# One file per backup target in /etc/agenda-backup/, readable only by the user agenda.
# Example: Hetzner Storage Box over SFTP (SSH key of the user agenda, see DEPLOY.md 8a).
RESTIC_REPOSITORY=sftp://u123456@u123456.your-storagebox.de:23/agenda
RESTIC_PASSWORD_FILE=/etc/agenda-backup/storagebox.password
RESTIC_SFTP_ARGS="-i /etc/agenda-backup/id_ed25519 -o UserKnownHostsFile=/etc/agenda-backup/known_hosts"
