[Unit]
Description=Versioned backup of the agenda account files (restic)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agenda
Group=agenda
ExecStart=/usr/local/bin/agenda-backup
Environment=RESTIC_CACHE_DIR=/var/cache/agenda-backup
CacheDirectory=agenda-backup
# Read-only access to the data; nothing else on the system is written.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/var/lib/agenda
Nice=10
IOSchedulingClass=idle
